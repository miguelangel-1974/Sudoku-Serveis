<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clientFX.CtrlConfig">
    <Label text="Sudoku" />
    <HBox alignment="CENTER" spacing="10">
        <Label text="Protocol" />
        <TextField fx:id="txtProtocol" text="ws" />
    </HBox>
    <HBox alignment="CENTER" spacing="10">
        <Label text="Server IP" />
        <TextField fx:id="txtHost" text="localhost" />
    </HBox>
    <HBox alignment="CENTER" spacing="10">
        <Label text="Port" />
        <TextField fx:id="txtPort" text="3000" />
    </HBox>
    <HBox alignment="CENTER" spacing="10">
        <Label text="Nom" />
        <TextField fx:id="txtName" />
    </HBox>
    <Button text="Connect" onAction="#connectToServer" />
    <Label fx:id="txtMessage" />
</VBox>
